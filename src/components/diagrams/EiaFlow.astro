---
// 東澳集點系統：從掃碼到扭蛋機出球的流程（依 EIA project 的 src/index.js 與 docs/FIRMWARE_INTERFACE.md 整理）
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';

const who = {
  phone: zh ? '遊客手機' : 'Visitor phone',
  worker: zh ? 'Cloudflare Worker＋KV' : 'Cloudflare Worker + KV',
  machine: zh ? '扭蛋機' : 'Capsule machine',
};

const steps = [
  {
    w: 'phone',
    t: zh ? '掃店家 QR' : 'Scan a shop QR',
    d: zh ? '網址帶著店家專屬 token，開啟集點卡' : 'The URL carries a per-shop token and opens the stamp card',
  },
  {
    w: 'worker',
    t: zh ? '驗證店家' : 'Verify the shop',
    api: '/api/shop',
    d: zh ? 'token 對不上就不蓋章' : 'No stamp unless the token matches',
  },
  {
    w: 'worker',
    t: zh ? '蓋章' : 'Stamp',
    api: '/api/stamp',
    d: zh ? '寫進 KV；依 IP 限流（10 秒 50 次）' : 'Saved to KV; per-IP rate limit (50 per 10 s)',
  },
  {
    w: 'phone',
    t: zh ? '集滿 3 家' : 'Collect 3 shops',
    api: '/api/get_card',
    d: zh ? '換手機也能用卡號找回進度' : 'Progress can be restored on another phone by card number',
  },
  {
    w: 'worker',
    t: zh ? '簽發兌換 QR' : 'Issue a redemption QR',
    api: '/api/sign',
    d: zh ? '從 KV 重算章數，AES-256-GCM 加密並附簽發時間' : 'Recounts stamps from KV, encrypts with AES-256-GCM plus an issue time',
  },
  {
    w: 'machine',
    t: zh ? '解密、出球' : 'Decrypt and dispense',
    d: zh ? '5 分鐘內有效，扣掉這張卡已領過的球數' : 'Valid for 5 minutes; subtracts capsules already given to this card',
  },
] as const;
---

<figure class="flow">
  <div class="legend" aria-hidden="true">
    <span class="chip y">{who.phone}</span>
    <span class="chip b">{who.worker}</span>
    <span class="chip p">{who.machine}</span>
  </div>
  <ol class="steps">
    {
      steps.map((s, i) => (
        <li class:list={['step', s.w]}>
          <span class="num">{i + 1}</span>
          <span class="who">{who[s.w]}</span>
          <strong class="t">{s.t}</strong>
          {'api' in s && <code class="api">{s.api}</code>}
          <span class="d">{s.d}</span>
        </li>
      ))
    }
  </ol>
  <figcaption class="note">
    {zh
      ? '前端只負責畫面；能不能換、換幾顆，一律由後端從資料庫重算，前端傳來的數字一個都不信。'
      : 'The frontend only draws the screen. Whether a visitor can redeem, and how many capsules, is always recomputed on the backend; nothing the client sends is trusted.'}
  </figcaption>
</figure>

<style>
  .flow {
    margin: 0;
    padding: 24px;
    border: 2.5px solid var(--ink);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--hard-sm);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }
  .legend .chip {
    font-size: 13px;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px 34px;
    counter-reset: s;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 16px 14px;
    border: 2.5px solid var(--ink);
    border-radius: 18px;
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .step.phone { background: var(--yellow); }
  .step.worker { background: var(--blue); color: #ffffff; }
  .step.machine { background: var(--pink); }
  /* 同一列之間的箭頭 */
  .step:not(:nth-child(3n))::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -30px;
    width: 22px;
    height: 14px;
    transform: translateY(-50%);
    background: var(--text);
    clip-path: polygon(0 35%, 60% 35%, 60% 0, 100% 50%, 60% 100%, 60% 65%, 0 65%);
  }
  .num {
    position: absolute;
    top: -14px;
    left: -12px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 2.5px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 15px;
  }
  .who {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }
  .t {
    font-size: 17px;
    font-weight: 900;
  }
  .api {
    align-self: flex-start;
    padding: 1px 8px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
    font-size: 12px;
  }
  .d {
    font-size: 13.5px;
    line-height: 1.55;
  }
  .note {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 2px dashed var(--soft-line);
    font-size: 14.5px;
    color: var(--text-soft);
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .step:not(:nth-child(3n))::after {
      content: none;
    }
    /* 直排時改成向下的箭頭 */
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 50%;
      right: auto;
      top: auto;
      bottom: -26px;
      width: 14px;
      height: 20px;
      transform: translateX(-50%);
      background: var(--text);
      clip-path: polygon(35% 0, 65% 0, 65% 60%, 100% 60%, 50% 100%, 0 60%, 35% 60%);
    }
  }
  @media (max-width: 640px) {
    .flow {
      padding: 18px 16px;
    }
  }
</style>
