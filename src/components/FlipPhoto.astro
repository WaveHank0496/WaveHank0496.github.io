---
interface Props {
  size: number;
  label: string;
  alt: string;
  altBack: string;
}
const { size, label, alt, altBack } = Astro.props;
---

<button class="flip" type="button" aria-label={label} title={label} aria-pressed="false" style={`--size:${size}px`}>
  <span class="inner">
    <img class="face front" src="/images/me/photo.webp" alt={alt} width="480" height="480" />
    <img class="face back" src="/images/me/photo-yawn.webp" alt={altBack} width="480" height="480" loading="lazy" />
  </span>
</button>

<style>
  .flip {
    flex: none;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    cursor: pointer;
    perspective: 800px;
  }
  .inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .flip[aria-pressed='true'] .inner {
    transform: rotateY(180deg);
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--cream);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .back {
    transform: rotateY(180deg);
  }
  .flip {
    box-shadow: 4px 4px 0 var(--ink);
  }
  .flip:hover .face {
    border-color: var(--pink);
  }
  @media (prefers-reduced-motion: reduce) {
    .inner {
      transition: none;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('.flip').forEach(function (b) {
    if (b.dataset.bound) return;
    b.dataset.bound = '1';
    b.addEventListener('click', function () {
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
    });
  });
</script>
