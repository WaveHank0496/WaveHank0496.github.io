---
import type { CollectionEntry } from 'astro:content';
import { ui, path, type Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  size?: 'wide' | 'large' | 'normal';
  eager?: boolean;
}
const { project, lang, size = 'normal', eager = false } = Astro.props;
const d = project.data;
const t = ui[lang];
const href = path(lang, `/projects/${project.id}`);
---

<a class:list={['card', 'reveal', size]} href={href}>
  <div class="cover">
    <img src={d.cover} alt="" width="1600" height="1000" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="body">
    <div class="meta">
      <span>{d.date[lang]}</span>
      {d.isPrivate && <span class="tag">{t.privateTag}</span>}
      {d.status && <span class="tag tag-accent">{d.status[lang]}</span>}
    </div>
    <h3 class="title">{d.title[lang]}</h3>
    <p class="summary">{d.summary[lang]}</p>
    <div class="tags">
      {d.stack.slice(0, size === 'normal' ? 3 : 4).map((s) => <span class="tag">{s}</span>)}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 3px solid var(--ink);
    border-radius: 26px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--hard);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .cover {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--cover-bg);
    border-bottom: 3px solid var(--ink);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 19px;
    line-height: 1.4;
  }
  .large .title {
    font-size: 21px;
  }
  .summary {
    margin: 0;
    color: var(--text-soft);
    font-size: 15px;
    line-height: 1.65;
    flex: 1;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .wide {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
  }
  .wide .cover {
    aspect-ratio: auto;
    min-height: 100%;
    border-bottom: 0;
    border-right: 3px solid var(--ink);
  }
  .wide .body {
    padding: 32px;
    justify-content: center;
    gap: 14px;
  }
  .wide .title {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.3;
  }
  .wide .summary {
    flex: none;
    font-size: 16px;
  }
  @media (max-width: 860px) {
    .wide {
      display: flex;
    }
    .wide .cover {
      aspect-ratio: 16 / 10;
      min-height: 0;
      border-right: 0;
      border-bottom: 3px solid var(--ink);
    }
    .wide .body {
      padding: 20px 22px 22px;
    }
  }
  @media (max-width: 640px) {
    .card {
      border-radius: 22px;
      box-shadow: 4px 4px 0 var(--ink);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
